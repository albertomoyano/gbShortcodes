' Gambas module file

' ============================================
' Módulo    : m_Base
' Propósito : Dueño de la conexión SQLite. Crea la base si no existe,
'             la abre, activa las claves foráneas y verifica la versión
'             del esquema antes de que cualquier otro módulo la use.
'             La base vive en ~/.gbshortcodes/shortcodes.sqlite
'             Es el m_Base de gbCorpus con otro esquema.
' ============================================

Public hConn As Connection

Public Const VERSION_ESQUEMA As Integer = 4

' --- ESTADO DE LA ÚLTIMA VERIFICACIÓN DE ESQUEMA ---
' UNA BASE UNA VERSIÓN ATRÁS NO ES UN ERROR: FMain OFRECE MIGRARLA CON EL
' IMPORTADOR Y EL SCRIPT QUE VIAJAN CON ESTE MISMO PROGRAMA
Private $bMigracionPendiente As Boolean
Private $iVersionBase As Integer
Public Const NOMBRE_BASE As String = "shortcodes.sqlite"
Public Const TIPO_DRIVER As String = "sqlite3"

' ============================================
' Función   : CarpetaBase
' Propósito : Devuelve la carpeta donde vive el archivo de la base.
'             Es una carpeta oculta en la home del usuario, de modo que
'             la aplicación pueda instalarse por .deb en /usr/bin y la
'             base siga estando en un lugar escribible.
' Parámetros: ninguno
' Retorna   : String — ruta absoluta de la carpeta
' ============================================
Public Function CarpetaBase() As String

  Return User.Home &/ ".gbshortcodes"

End

' ============================================
' Función   : RutaArchivoBase
' Propósito : Ruta completa del archivo .sqlite
' Parámetros: ninguno
' Retorna   : String — ruta absoluta del archivo
' ============================================
Public Function RutaArchivoBase() As String

  Return CarpetaBase() &/ NOMBRE_BASE

End

' ============================================
' Función   : Conectar
' Propósito : Abre la conexión con la base, creándola si hace falta.
'             Fail-fast ordenado: infraestructura, luego configuración.
' Parámetros: ninguno
' Retorna   : Boolean — True si la conexión quedó utilizable
' ============================================
Public Function Conectar() As Boolean

  Dim sCarpeta As String
  Dim sArchivo As String

  ' --- 1. INICIALIZACIÓN ---
  sCarpeta = CarpetaBase()
  sArchivo = RutaArchivoBase()

  ' --- 2. LA CARPETA OCULTA SE CREA EN EL PRIMER ARRANQUE ---
  If Not Exist(sCarpeta) Then
    Try Mkdir sCarpeta
    If Error Then
      Message.Error("No se pudo crear la carpeta de la base:" & Chr(10) &
        sCarpeta & Chr(10) & Error.Text)
      Return False
    Endif
  Endif

  ' --- 3. SI NO HAY ARCHIVO, SE CREA LA BASE VACÍA CON SU ESQUEMA ---
  If Not Exist(sArchivo) Then
    If Not CrearBaseVacia(sCarpeta) Then Return False
  Endif

  ' --- 4. APERTURA DE LA CONEXIÓN DE TRABAJO ---
  hConn = New Connection
  hConn.Type = TIPO_DRIVER
  hConn.Host = sCarpeta
  hConn.Name = NOMBRE_BASE

  Try hConn.Open()
  If Error Then
    Message.Error("No se pudo abrir la base:" & Chr(10) &
      sArchivo & Chr(10) & Error.Text)
    hConn = Null
    Return False
  Endif

  ' --- 5. CLAVES FORÁNEAS: SON POR CONEXIÓN (GV-30) ---
  ' DESDE EL ESQUEMA 4, EL PAR (modo, tipo) DE CADA SHORTCODE ES UNA CLAVE
  ' FORÁNEA A modos: SIN ESTO SERÍA DECORATIVA
  Try hConn.Exec("PRAGMA foreign_keys = ON")
  If Error Then
    Message.Warning("No se pudieron activar las claves foráneas." & Chr(10) &
      "La integridad referencial queda sin verificar." & Chr(10) &
      Error.Text)
  Endif

  ' --- 6. VERIFICACIÓN DE VERSIÓN DE ESQUEMA ---
  Return VerificarEsquema()

End

' ============================================
' Función   : VerificarEsquema
' Propósito : Confirma que la base abierta tiene la versión de esquema
'             que este binario sabe manejar.
' Parámetros: ninguno
' Retorna   : Boolean — True si la versión coincide
' ============================================
Public Function VerificarEsquema() As Boolean

  Dim rVersion As Result
  Dim iVersion As Integer

  ' --- 1. LECTURA DE LA VERSIÓN REGISTRADA ---
  Try rVersion = hConn.Exec("SELECT version FROM esquema_version " &
    "ORDER BY version DESC LIMIT 1")
  If Error Then
    Message.Error("La base no tiene tabla esquema_version." & Chr(10) &
      "Puede no ser una base de shortcodes válida." & Chr(10) & Error.Text)
    Return False
  Endif

  ' --- 2. TABLA PRESENTE PERO VACÍA: TAMBIÉN ES ESQUEMA INVÁLIDO ---
  If Not rVersion.Available Then
    Message.Error("La tabla esquema_version está vacía.")
    Return False
  Endif

  iVersion = rVersion["version"]
  $iVersionBase = iVersion

  ' --- 3. UNA VERSIÓN ATRÁS: MIGRACIÓN PENDIENTE, SIN MENSAJE ---
  ' FMain LA OFRECE Y LA CORRE CON EL IMPORTADOR Y EL SCRIPT DE ESTE MISMO
  ' PROGRAMA. SE CIERRA LA CONEXIÓN: sqlite3 NECESITA EL LOCK DE ESCRITURA
  If iVersion = VERSION_ESQUEMA - 1 Then
    $bMigracionPendiente = True
    Cerrar()
    Return False
  Endif
  $bMigracionPendiente = False

  ' --- 4. COMPARACIÓN CONTRA LA VERSIÓN QUE ESTE BINARIO MANEJA ---
  If iVersion <> VERSION_ESQUEMA Then
    Message.Error("Versión de esquema incompatible." & Chr(10) &
      "La base es v" & CStr(iVersion) &
      " y el programa espera v" & CStr(VERSION_ESQUEMA) & ".")
    Return False
  Endif

  Return True

End

' ============================================
' Función   : MigracionPendiente
' Propósito : Dice si la última conexión encontró la base una versión atrás
' Parámetros: ninguno
' Retorna   : Boolean — True si hay que migrar antes de abrir
' ============================================
Public Function MigracionPendiente() As Boolean

  Return $bMigracionPendiente

End

' ============================================
' Función   : VersionBase
' Propósito : La versión de esquema que la última conexión leyó en la base
' Parámetros: ninguno
' Retorna   : Integer — la versión; 0 si todavía no se leyó
' ============================================
Public Function VersionBase() As Integer

  Return $iVersionBase

End

' ============================================
' Función   : BaseVacia
' Propósito : Dice si el catálogo no tiene ningún shortcode: una base recién
'             creada, que espera la carga inicial
' Parámetros: ninguno
' Retorna   : Boolean — True si no hay filas; False también si no se pudo leer
' ============================================
Public Function BaseVacia() As Boolean

  Dim rCuenta As Result

  ' --- 1. SIN CONEXIÓN NO HAY NADA QUE CONTAR ---
  If IsNull(hConn) Then Return False

  ' --- 2. CUENTA ---
  Try rCuenta = hConn.Exec("SELECT COUNT(*) AS n FROM shortcodes")
  If Error Then Return False
  Return (rCuenta["n"] = 0)

End

' ============================================
' Función   : Cerrar
' Propósito : Cierra la conexión de forma idempotente
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Cerrar()

  ' --- 1. NADA QUE CERRAR ---
  If IsNull(hConn) Then Return

  ' --- 2. CIERRE PROTEGIDO: UN FALLO ACÁ NO DEBE IMPEDIR SALIR ---
  Try hConn.Close()
  hConn = Null

End

' ============================================
' Función   : CrearBaseVacia
' Propósito : Crea el archivo .sqlite y ejecuta el DDL completo.
' Parámetros: sCarpeta As String — carpeta donde crear el archivo
' Retorna   : Boolean — True si la base quedó creada y poblada
' ============================================
Private Function CrearBaseVacia(sCarpeta As String) As Boolean

  Dim hCrear As Connection
  Dim aDDL As String[]
  Dim sSentencia As String

  ' --- 1. CONEXIÓN SIN BASE: EN SQLITE, EL "SERVIDOR" ES LA CARPETA ---
  hCrear = New Connection
  hCrear.Type = TIPO_DRIVER
  hCrear.Host = sCarpeta
  hCrear.Name = ""

  Try hCrear.Open()
  If Error Then
    Message.Error("No se pudo acceder a la carpeta de bases:" & Chr(10) &
      sCarpeta & Chr(10) & Error.Text)
    Return False
  Endif

  ' --- 2. ALTA DEL ARCHIVO DE BASE ---
  Try hCrear.Databases.Add(NOMBRE_BASE)
  If Error Then
    Message.Error("No se pudo crear el archivo de base." & Chr(10) & Error.Text)
    Try hCrear.Close()
    Return False
  Endif

  Try hCrear.Close()

  ' --- 3. REAPERTURA YA SOBRE LA BASE CREADA ---
  hCrear.Name = NOMBRE_BASE
  Try hCrear.Open()
  If Error Then
    Message.Error("La base se creó pero no se pudo abrir." & Chr(10) & Error.Text)
    Return False
  Endif

  ' --- 4. EJECUCIÓN DEL DDL, SENTENCIA POR SENTENCIA ---
  ' EL DRIVER NO ACEPTA VARIAS SENTENCIAS EN UNA SOLA LLAMADA
  aDDL = SentenciasDDL()
  For Each sSentencia In aDDL
    Try hCrear.Exec(sSentencia)
    If Error Then
      Message.Error("Fallo al crear el esquema." & Chr(10) &
        "Sentencia: " & Left$(sSentencia, 60) & Chr(10) & Error.Text)
      Try hCrear.Close()
      Return False
    Endif
  Next

  Try hCrear.Close()
  Return True

End

' ============================================
' Función   : SentenciasDDL
' Propósito : Devuelve el DDL como sentencias sueltas. Vive en código y
'             no en un archivo externo para que la creación de la base no
'             dependa de que un .sql viaje junto al ejecutable.
'             ES EL MISMO DDL QUE shortcodes_esquema.sql: SI SE CAMBIA
'             UNO, SE CAMBIA EL OTRO.
' Parámetros: ninguno
' Retorna   : String[] — sentencias en orden de ejecución
' ============================================
Private Function SentenciasDDL() As String[]

  Dim aDDL As New String[]

  ' --- 1. TABLA DE MODOS: UN MODO NUEVO ES UN DATO, NO UN CAMBIO DE ESQUEMA ---
  aDDL.Add("CREATE TABLE modos (" &
    "modo TEXT NOT NULL CHECK (modo <> '' AND modo NOT GLOB '*[^a-z-]*'), " &
    "tipo TEXT NOT NULL CHECK (tipo IN ('bloque','linea')), " &
    "descripcion TEXT NOT NULL CHECK (descripcion <> ''), " &
    "PRIMARY KEY (modo, tipo))")
  aDDL.Add("INSERT INTO modos (modo, tipo, descripcion) VALUES " &
    "('envolver', 'bloque', 'Rodea la selección con la apertura y el cierre.'), " &
    "('envolver', 'linea', 'Rodea la selección dentro del párrafo: [texto]{.clase}.'), " &
    "('plantilla', 'bloque', 'Inserta apertura, marcador y cierre, sin selección.'), " &
    "('plantilla', 'linea', 'Inserta apertura, marcador y cierre dentro del párrafo, sin selección.'), " &
    "('figura', 'bloque', 'El camino de FMain.InsertarFigura de gbpublisher (SC-32).'), " &
    "('dos-partes', 'bloque', 'Envolver, si la selección tiene la forma {primera}{segunda} (SC-35).')")

  ' --- 1b. TABLA DE SHORTCODES ---
  ' que_es, ejemplo Y como_sale ADMITEN NULL: Edit + Update ESCRIBE LA
  ' CADENA VACÍA COMO NULL, Y UN NOT NULL HARÍA FALLAR EL GUARDADO DE UNA
  ' SECCIÓN VACÍA (VERIFICADO EN 3.19 CON gb.db.sqlite3)
  aDDL.Add("CREATE TABLE shortcodes (" &
    "id_shortcode INTEGER PRIMARY KEY, " &
    "nombre TEXT NOT NULL UNIQUE " &
    "CHECK (nombre <> '' AND nombre NOT GLOB '*[^a-z0-9-]*'), " &
    "clase TEXT NOT NULL " &
    "CHECK (clase <> '' AND clase NOT GLOB '*[^a-z0-9-]*'), " &
    "etiqueta TEXT NOT NULL CHECK (etiqueta <> ''), " &
    "tipo TEXT NOT NULL CHECK (tipo IN ('bloque','linea')), " &
    "grupo TEXT NOT NULL CHECK (grupo IN ('comun','estructura','disciplinar')), " &
    "perfil TEXT CHECK (perfil <> '' AND perfil NOT GLOB '*[^a-z_]*'), " &
    "orden INTEGER NOT NULL, " &
    "estado_libro TEXT NOT NULL DEFAULT 'no_aplica' " &
    "CHECK (estado_libro IN ('no_aplica','borrador','liberado')), " &
    "estado_revista TEXT NOT NULL DEFAULT 'no_aplica' " &
    "CHECK (estado_revista IN ('no_aplica','borrador','liberado')), " &
    "modo TEXT NOT NULL DEFAULT 'envolver', " &
    "apertura TEXT NOT NULL CHECK (apertura <> ''), " &
    "cierre TEXT NOT NULL CHECK (cierre <> ''), " &
    "que_es TEXT CHECK (que_es <> ''), " &
    "ejemplo TEXT CHECK (ejemplo <> ''), " &
    "como_sale TEXT CHECK (como_sale <> ''), " &
    "mapeo_docbook TEXT, " &
    "mapeo_jats TEXT, " &
    "notas TEXT, " &
    "pendiente TEXT, " &
    "fecha_alta TEXT NOT NULL, " &
    "fecha_modificacion TEXT NOT NULL, " &
    "CHECK ((grupo = 'disciplinar') = (perfil IS NOT NULL)), " &
    "CHECK (estado_libro <> 'no_aplica' OR estado_revista <> 'no_aplica'), " &
    "CHECK ((estado_libro <> 'liberado' AND estado_revista <> 'liberado') " &
    "OR (que_es IS NOT NULL AND ejemplo IS NOT NULL AND como_sale IS NOT NULL)), " &
    "CHECK ((estado_libro <> 'liberado' AND estado_revista <> 'liberado') " &
    "OR pendiente IS NULL), " &
    "CHECK (NOT (estado_libro = 'liberado' AND estado_revista = 'borrador') " &
    "AND NOT (estado_revista = 'liberado' AND estado_libro = 'borrador')), " &
    "FOREIGN KEY (modo, tipo) REFERENCES modos (modo, tipo))")

  ' --- 2. ÍNDICE DEL ORDEN DEL CATÁLOGO ---
  aDDL.Add("CREATE INDEX ix_shortcodes_orden ON shortcodes (grupo, perfil, orden)")
  aDDL.Add("CREATE INDEX ix_shortcodes_clase ON shortcodes (clase)")

  ' --- 3. VERSIÓN DE ESQUEMA ---
  aDDL.Add("CREATE TABLE esquema_version (version INTEGER NOT NULL, fecha TEXT NOT NULL)")

  ' --- 4. SELLO DE VERSIÓN ---
  aDDL.Add("INSERT INTO esquema_version VALUES (" & CStr(VERSION_ESQUEMA) &
    ", date('now'))")

  Return aDDL

End
