' ============================================
' Función   : mnuImpSQL_Click
' Propósito : Aplica un script SQL sobre el catálogo. La aplicación no
'             redacta el script ni lo interpreta: lo ejecuta el
'             importador de engine/ (SC-13).
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub mnuImpSQL_Click()

  Dim sImportador As String
  Dim sArchivo As String
  Dim bAplicado As Boolean

  ' --- 1. GUARD DE REENTRADA ---
  If $bImportando Then Return

  ' --- 2. GUARD DE CAMBIOS SIN GUARDAR (SC-06) ---
  ' VA ANTES DE TOCAR NADA: DESPUÉS DE CERRAR LA BASE YA NO HAY DÓNDE
  ' GUARDAR LO QUE EL USUARIO TENGA A MEDIO EDITAR
  If Not ConfirmarDescartarCambios() Then Return

  ' --- 3. EL IMPORTADOR TIENE QUE ESTAR DONDE SE LO ESPERA ---
  sImportador = RutaImportador()
  If sImportador = "" Then Return

  ' --- 4. ELECCIÓN DEL ARCHIVO ---
  sArchivo = ElegirScriptSQL()
  If sArchivo = "" Then Return

  ' --- 5. EJECUCIÓN EN EL TERMINAL EMBEBIDO ---
  bAplicado = EjecutarImportacion(sImportador, sArchivo)

  ' --- 6. REAPERTURA Y RECARGA, HAYA SALIDO BIEN O MAL (RC-GM-20) ---
  RecargarTrasImportar(bAplicado)

End

' Propósito : Ubica el script importador: desde el IDE, el de .hidden/engine
'             del proyecto; instalado, el de /usr/share/gbshortcodes. Mismo
'             criterio que m_InicioCierre.RutaRecursos de gbpublisher (SC-11).
' Parámetros: ninguno
' Retorna   : String — ruta absoluta, o cadena vacía si no está
' ============================================
Private Function RutaImportador() As String

  Dim sRutaProyecto As String
  Dim sRutaSistema As String

  ' --- 1. EJECUCIÓN DESDE EL IDE: EL SCRIPT DEL PROYECTO ---
  ' VA PRIMERO: SI NO, CON UN PAQUETE INSTALADO EL IDE CORRE EL SCRIPT DEL
  ' PAQUETE, QUE PUEDE SER DE OTRA VERSIÓN
  sRutaProyecto = Application.Path &/ ".hidden" &/ RUTA_IMPORTADOR
  If Exist(sRutaProyecto) Then Return sRutaProyecto

  ' --- 2. INSTALACIÓN DEL SISTEMA ---
  sRutaSistema = CARPETA_SISTEMA &/ RUTA_IMPORTADOR
  If Exist(sRutaSistema) Then Return sRutaSistema

  ' --- 3. AUSENCIA: SE DICE CON LAS DOS RUTAS A LA VISTA ---
  Message.Error("No se encontró el importador. Se buscó en:" & Chr(10) & Chr(10) &
    sRutaProyecto & Chr(10) & sRutaSistema)

  Return ""

End

' ============================================
' Función   : ElegirScriptSQL
' Propósito : Pide el archivo .sql a importar, recordando la carpeta
' Parámetros: ninguno
' Retorna   : String — ruta elegida, o cadena vacía si se canceló
' ============================================
Private Function ElegirScriptSQL() As String

  Dim sElegido As String

  ' --- 1. DIÁLOGO, CON LA ÚLTIMA CARPETA COMO PUNTO DE PARTIDA ---
  Dialog.Title = "Importar script SQL"
  Dialog.Filter = ["*.sql", "SQL"]
  Dialog.Path = Settings["Importar/UltimaCarpeta", User.Home]

  ' ATENCIÓN: LOS DIÁLOGOS DE GAMBAS DEVUELVEN True AL CANCELAR (GV-16)
  If Dialog.OpenFile() Then Return ""

  sElegido = Dialog.Path
  If sElegido = "" Then Return ""

  ' --- 2. MEMORIA DE LA CARPETA ---
  Settings["Importar/UltimaCarpeta"] = File.Dir(sElegido)

  Return sElegido

End

' ============================================
' Función   : EjecutarImportacion
' Propósito : Bloquea la interfaz, cierra la base, lanza el importador
'             en el TerminalView y espera a que termine. La base se
'             cierra porque sqlite3 necesita el lock de escritura.
' Parámetros: sImportador As String — ruta del script de engine/
'             sArchivo As String — ruta del .sql a aplicar
' Retorna   : Boolean — True si el importador devolvió código 0
' ============================================
Private Function EjecutarImportacion(sImportador As String, sArchivo As String) As Boolean

  Dim hProceso As Process
  Dim bAplicado As Boolean

  ' --- 1. BLOQUEO DE LA INTERFAZ ---
  $bImportando = True
  BloquearInterfaz(True)
  lblAviso.Text = "importación en curso"

  ' --- 2. LA PESTAÑA DEL TERMINAL AL FRENTE: AHÍ SE CONTESTA [s/N] ---
  tabDetalle.Index = tabDetalle.Count - 1

  ' --- 3. CIERRE DE LA BASE ---
  m_Base.Cerrar()

  ' --- 4. LANZAMIENTO CON ARRAY, NUNCA Shell (SC-05) ---
  ' POR bash Y NO DIRECTO, PARA NO DEPENDER DEL BIT DE EJECUCIÓN
  bAplicado = False

  Try hProceso = trmImportar.Exec(["bash", sImportador, sArchivo])
  If Error Then
    Message.Error("No se pudo lanzar el importador." & Chr(10) & Error.Text)
  Else
    $hImportacion = hProceso
    ' SIN FOCO EN EL TERMINAL NO SE PUEDE CONTESTAR EL PROMPT (RC-GM-07)
    trmImportar.SetFocus()
    bAplicado = EsperarProceso(hProceso)
    $hImportacion = Null
  Endif

  ' --- 5. DESBLOQUEO ---
  $bImportando = False
  BloquearInterfaz(False)

  Return bAplicado

End

' ============================================
' Función   : BloquearInterfaz
' Propósito : Apaga o enciende lo que no debe usarse mientras corre el
'             importador. Contenedor por contenedor y nunca un ancestro
'             del terminal: un terminal apagado no recibe teclado y el
'             prompt [s/N] queda sin respuesta posible (GV-42).
'             trmImportar cuelga de tabDetalle, de vbxDerecha y de
'             hspPrincipal: ninguno de los tres se apaga.
' Parámetros: bBloquear As Boolean — True apaga, False enciende
' Retorna   : nada
' ============================================
Private Sub BloquearInterfaz(bBloquear As Boolean)

  Dim bActivo As Boolean

  ' --- 1. EL VALOR QUE VA A LOS CONTROLES ES EL INVERSO ---
  bActivo = Not bBloquear

  ' --- 2. PANEL IZQUIERDO ENTERO ---
  vbxIzquierda.Enabled = bActivo

  ' --- 3. CAMPOS DEL DETALLE, UNO POR CONTENEDOR ---
  hbxCabecera.Enabled = bActivo
  hbxEtiqueta.Enabled = bActivo
  hbxEstados.Enabled = bActivo
  hbxSintaxis.Enabled = bActivo
  hbxPendiente.Enabled = bActivo
  hbxBotones.Enabled = bActivo

  ' --- 4. MENÚ: IMPIDE RELANZAR Y EXPORTAR CON LA BASE CERRADA ---
  mnuCatalogo.Enabled = bActivo

End

' ============================================
' Función   : EsperarProceso
' Propósito : Espera a que el importador termine con la SENTENCIA Wait;
'             Process.Wait() colgaría la aplicación (GV-17).
' Parámetros: hProceso As Process — proceso devuelto por Exec
' Retorna   : Boolean — True si terminó con código de salida 0
' ============================================
Private Function EsperarProceso(hProceso As Process) As Boolean

  Dim fVencimiento As Float
  Dim iCodigo As Integer

  ' --- 1. PLAZO: NO ES OPCIONAL, UN PROCESO PUEDE COLGARSE ---
  fVencimiento = Timer + SEGUNDOS_MAXIMOS

  ' --- 2. SONDEO ---
  While hProceso.State = Process.Running

    Wait 0.05

    If Timer > fVencimiento Then
      Try hProceso.Kill()
      Message.Error("La importación superó el plazo de " &
        CStr(CInt(SEGUNDOS_MAXIMOS / 60)) & " minutos y se interrumpió." & Chr(10) &
        "La transacción no se confirmó: el catálogo quedó como estaba.")
      Return False
    Endif

  Wend

  ' --- 3. LOS ÚLTIMOS TROZOS DE SALIDA PUEDEN LLEGAR DESPUÉS DEL FIN ---
  Wait 0.2

  ' --- 4. CÓDIGO DE SALIDA: ES TODO EL CONTRATO CON EL IMPORTADOR ---
  iCodigo = -1
  Try iCodigo = hProceso.Value

  Return (iCodigo = 0)

End

' ============================================
' Función   : RecargarTrasImportar
' Propósito : Reabre la base y repone la interfaz. Es el ÚNICO camino
'             que reabre la conexión.
' Parámetros: bAplicado As Boolean — si el importador devolvió 0
' Retorna   : nada
' ============================================
Private Sub RecargarTrasImportar(bAplicado As Boolean)

  ' --- 1. REAPERTURA: SIN BASE NO HAY APLICACIÓN ---
  If Not m_Base.Conectar() Then
    Me.Close
    Return
  Endif

  ' --- 2. RECARGA ---
  CargarComboFiltros()
  RefrescarLista(m_Catalogo.FILTRO_TODOS)
  LimpiarDetalle()
  ActualizarBotones()

  ' --- 3. VEREDICTO A LA VISTA; EL DETALLE QUEDÓ EN LA PESTAÑA ---
  If bAplicado Then
    lblAviso.Text = "importación aplicada"
    tabDetalle.Index = 0
  Else
    lblAviso.Text = "importación no aplicada — ver la pestaña Terminal"
  Endif

End

' ============================================
' Función   : MarcarModificado
' Propósito : Registra que hay cambios sin guardar, salvo que el cambio
'             lo haya producido la propia carga de datos.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub MarcarModificado()

  ' --- 1. LOS CAMBIOS DE LA CARGA NO CUENTAN ---
  If $bCargando Then Return
  If m_Catalogo.NombreEnCurso = "" Then Return

  ' --- 2. AVISO VISIBLE ---
  $bModificado = True
  lblAviso.Text = "cambios sin guardar"

End

' ============================================
' Función   : ConfirmarDescartarCambios
' Propósito : Guard de SC-06. Se invoca ANTES de cualquier cambio de
'             contexto y antes de tocar la UI.
' Parámetros: ninguno
' Retorna   : Boolean — True si se puede continuar
' ============================================
Private Function ConfirmarDescartarCambios() As Boolean

  ' --- 1. SIN CAMBIOS, NADA QUE PREGUNTAR ---
  If Not $bModificado Then Return True

  ' --- 2. DECISIÓN DEL USUARIO ---
  If Message.Question(m_Catalogo.NombreEnCurso & " tiene cambios sin guardar.",
      "Descartar", "Cancelar") = 1 Then
    $bModificado = False
    Return True
  Endif

  Return False

End

' ============================================
' Función   : ExigirGuardado
' Propósito : Las exportaciones leen la base. Con cambios sin guardar
'             saldría la versión anterior sin que nada lo advierta.
' Parámetros: ninguno
' Retorna   : Boolean — True si no hay cambios pendientes
' ============================================
Private Function ExigirGuardado() As Boolean

  If Not $bModificado Then Return True

  Message.Warning(m_Catalogo.NombreEnCurso & " tiene cambios sin guardar." & Chr(10) &
    "La exportación usa lo guardado: guardar o descartar antes de exportar.")
  Return False

End

' ============================================
' Función   : CargarComboFiltros
' Propósito : Puebla el combo de filtros
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub CargarComboFiltros()

  Dim sEtiqueta As String

  $bCargando = True

  ' --- 1. ETIQUETAS ARMADAS POR EL MÓDULO, QUE ES DUEÑO DEL MAPEO ---
  cmbFiltro.Clear()
  For Each sEtiqueta In m_Catalogo.CargarFiltros()
    cmbFiltro.Add(sEtiqueta)
  Next

  ' --- 2. ARRANQUE EN EL CATÁLOGO COMPLETO ---
  If cmbFiltro.Count > 0 Then cmbFiltro.Index = 0
  $iFiltroEnCurso = 0

  $bCargando = False

End

' ============================================
' Función   : RefrescarLista
' Propósito : Repuebla el ListBox con el filtro indicado
' Parámetros: sFiltro As String — token del filtro
' Retorna   : nada
' ============================================
Private Sub RefrescarLista(sFiltro As String)

  Dim aLineas As String[]
  Dim sLinea As String

  $bCargando = True

  ' --- 1. CONSULTA Y VOLCADO ---
  aLineas = m_Catalogo.CargarShortcodes(sFiltro)
  lstShortcodes.Clear()
  For Each sLinea In aLineas
    lstShortcodes.Add(sLinea)
  Next

  $bCargando = False

  ' --- 2. UNA LISTA VACÍA SE DICE, NO SE DEJA EN SILENCIO (GV-23) ---
  If aLineas.Count = 0 Then
    If sFiltro = m_Catalogo.FILTRO_TODOS Then
      lblAviso.Text = "el catálogo está vacío: importar la carga inicial"
    Else
      lblAviso.Text = "ningún shortcode cumple este filtro"
    Endif
  Else
    lblAviso.Text = CStr(aLineas.Count) & " shortcodes"
  Endif

End

' ============================================
' Función   : MostrarShortcode
' Propósito : Vuelca un shortcode al panel de detalle
' Parámetros: sNombre As String — nombre del shortcode
' Retorna   : nada
' ============================================
Private Sub MostrarShortcode(sNombre As String)

  Dim oFila As CShortcode

  ' --- 1. LECTURA ---
  oFila = m_Catalogo.LeerShortcode(sNombre)
  If IsNull(oFila) Then
    Message.Warning("No se encontró el shortcode " & sNombre & ".")
    Return
  Endif

  ' --- 2. ESTADO DE SESIÓN EN EL MÓDULO, NO EN LOS CONTROLES (RC-GM-16) ---
  m_Catalogo.NombreEnCurso = oFila.sNombre

  ' --- 3. VOLCADO A LA UI, CON LOS EVENTOS SUPRIMIDOS ---
  $bCargando = True

  txtNombre.Text = oFila.sNombre
  txtClase.Text = oFila.sClase
  txtTipo.Text = oFila.sTipo
  txtModo.Text = oFila.sModo
  txtEtiqueta.Text = oFila.sEtiqueta
  txtGrupo.Text = oFila.sGrupo
  If oFila.sPerfil <> "" Then txtGrupo.Text = oFila.sGrupo & " · " & oFila.sPerfil
  txtEstadoLibro.Text = oFila.sEstadoLibro
  txtEstadoRevista.Text = oFila.sEstadoRevista
  ' EL SALTO DE LÍNEA DE UNA APERTURA DE DOS LÍNEAS SE MUESTRA COMO ⏎
  txtApertura.Text = Replace(oFila.sApertura, Chr(10), " ⏎ ")
  txtCierre.Text = Replace(oFila.sCierre, Chr(10), " ⏎ ")
  txaQueEs.Text = oFila.sQueEs
  txaEjemplo.Text = oFila.sEjemplo
  txaComoSale.Text = oFila.sComoSale
  txtMapeoDocbook.Text = oFila.sMapeoDocbook
  txtMapeoJats.Text = oFila.sMapeoJats
  txaNotas.Text = oFila.sNotas
  txaPendiente.Text = oFila.sPendiente

  ' LOS TEXTOS PUEDEN SER LARGOS: DESDE EL PRINCIPIO. TextArea NO TIENE
  ' EL PROBLEMA DE Pos DE TextEdit (GV-44)
  txaQueEs.Pos = 0
  txaEjemplo.Pos = 0
  txaComoSale.Pos = 0
  txaNotas.Pos = 0

  $bCargando = False

  ' --- 4. LIMPIEZA DE ESTADO ---
  $bModificado = False
  lblAviso.Text = ""

  ' --- 5. SI LA VISTA PREVIA ESTÁ A LA VISTA, SE REARMA ---
  If tabDetalle.Index = PESTANA_PREVIA Then RefrescarVistaPrevia()

  ActualizarBotones()

End

' ============================================
' Función   : ObjetoDeUI
' Propósito : Lee el shortcode en curso de la base y le pone encima lo
'             que está escrito en la pantalla. Lo usan el guardado y la
'             vista previa, que tiene que mostrar lo no guardado.
' Parámetros: ninguno
' Retorna   : CShortcode — objeto con los textos de la UI, o Null
' ============================================
Private Function ObjetoDeUI() As CShortcode

  Dim oFila As CShortcode

  ' --- 1. LO QUE LA UI NO EDITA SALE DE LA BASE ---
  oFila = m_Catalogo.LeerShortcode(m_Catalogo.NombreEnCurso)
  If IsNull(oFila) Then
    Message.Error("El shortcode " & m_Catalogo.NombreEnCurso & " ya no está en la base.")
    Return Null
  Endif

  ' --- 2. LO QUE LA UI EDITA ---
  oFila.sEtiqueta = Trim$(txtEtiqueta.Text)
  oFila.sQueEs = m_Catalogo.SinRetornos(txaQueEs.Text)
  oFila.sEjemplo = m_Catalogo.SinRetornos(txaEjemplo.Text)
  oFila.sComoSale = m_Catalogo.SinRetornos(txaComoSale.Text)
  oFila.sMapeoDocbook = Trim$(txtMapeoDocbook.Text)
  oFila.sMapeoJats = Trim$(txtMapeoJats.Text)
  oFila.sNotas = txaNotas.Text
  oFila.sPendiente = Trim$(txaPendiente.Text)

  Return oFila

End

' ============================================
' Función   : SeccionesVacias
' Propósito : Nombra las secciones de la ayuda que están vacías
' Parámetros: oFila As CShortcode — shortcode
' Retorna   : String — nombres separados por coma; vacío si no falta nada
' ============================================
Private Function SeccionesVacias(oFila As CShortcode) As String

  Dim aFaltan As New String[]

  If Trim$(oFila.sQueEs) = "" Then aFaltan.Add("Qué es")
  If Trim$(oFila.sEjemplo) = "" Then aFaltan.Add("Ejemplo")
  If Trim$(oFila.sComoSale) = "" Then aFaltan.Add("Cómo sale")

  Return aFaltan.Join(", ")

End

' ============================================
' Función   : RefrescarVistaPrevia
' Propósito : Arma la página de ayuda del shortcode en curso con lo que
'             está escrito en la pantalla.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub RefrescarVistaPrevia()

  Dim oFila As CShortcode

  ' --- 1. SIN SHORTCODE EN CURSO, LA VISTA QUEDA VACÍA ---
  If m_Catalogo.NombreEnCurso = "" Then
    txtPrevia.RichText = ""
    Return
  Endif

  oFila = ObjetoDeUI()
  If IsNull(oFila) Then Return

  ' --- 2. ARMADO: DOS LLAMADAS A PANDOC ---
  Application.Busy += 1
  txtPrevia.RichText = m_Exportar.VistaPrevia(oFila)
  Application.Busy -= 1

  ' --- 3. DESDE EL PRINCIPIO: RichText DEJA EL CURSOR AL FINAL (GV-37) ---
  ' NUNCA SE ESCRIBE Pos EN UN TextEdit (GV-44)
  txtPrevia.Select(0, 0)
  txtPrevia.ScrollY = 0

End

' ============================================
' Función   : SeleccionarNombre
' Propósito : Lleva la selección de la lista a un shortcode, abriendo el
'             filtro si no está visible.
' Parámetros: sNombre As String — nombre destino
' Retorna   : nada
' ============================================
Private Sub SeleccionarNombre(sNombre As String)

  Dim iIndice As Integer

  ' --- 1. BÚSQUEDA EN LA LISTA ACTUAL ---
  iIndice = m_Catalogo.IndiceDeNombre(sNombre)

  ' --- 2. SI EL FILTRO LO ESCONDE, SE ABRE AL CATÁLOGO COMPLETO ---
  If iIndice < 0 Then
    $bCargando = True
    cmbFiltro.Index = 0
    $bCargando = False
    $iFiltroEnCurso = 0
    RefrescarLista(m_Catalogo.FILTRO_TODOS)
    iIndice = m_Catalogo.IndiceDeNombre(sNombre)
  Endif

  If iIndice < 0 Then
    Message.Warning("No se pudo ubicar " & sNombre & " en la lista.")
    Return
  Endif

  ' --- 3. SELECCIÓN SIN DISPARAR EL HANDLER ---
  $bCargando = True
  lstShortcodes.Index = iIndice
  $bCargando = False

  MostrarShortcode(sNombre)

End

' ============================================
' Función   : RestaurarSeleccionShortcode
' Propósito : Devuelve la lista al shortcode en curso cuando el usuario
'             cancela el descarte de cambios.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub RestaurarSeleccionShortcode()

  Dim iIndice As Integer

  ' --- 1. PUEDE NO ESTAR EN LA LISTA ACTUAL ---
  iIndice = m_Catalogo.IndiceDeNombre(m_Catalogo.NombreEnCurso)
  If iIndice < 0 Then Return

  ' --- 2. RESTAURACIÓN SIN DISPARAR EL HANDLER ---
  $bCargando = True
  lstShortcodes.Index = iIndice
  $bCargando = False

End

' ============================================
' Función   : RestaurarSeleccionFiltro
' Propósito : Devuelve el combo al filtro que estaba aplicado cuando el
'             usuario cancela el descarte de cambios.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub RestaurarSeleccionFiltro()

  ' --- 1. GUARDA DE RANGO ---
  If $iFiltroEnCurso < 0 Then Return
  If $iFiltroEnCurso >= cmbFiltro.Count Then Return

  ' --- 2. RESTAURACIÓN SIN DISPARAR EL HANDLER ---
  $bCargando = True
  cmbFiltro.Index = $iFiltroEnCurso
  $bCargando = False

End

' ============================================
' Función   : LimpiarDetalle
' Propósito : Deja el panel derecho vacío y sin shortcode en curso
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub LimpiarDetalle()

  ' --- 1. BLANQUEO DE CONTROLES, SIN LEVANTAR EVENTOS ---
  $bCargando = True

  txtNombre.Text = ""
  txtClase.Text = ""
  txtTipo.Text = ""
  txtModo.Text = ""
  txtEtiqueta.Text = ""
  txtGrupo.Text = ""
  txtEstadoLibro.Text = ""
  txtEstadoRevista.Text = ""
  txtApertura.Text = ""
  txtCierre.Text = ""
  txaQueEs.Text = ""
  txaEjemplo.Text = ""
  txaComoSale.Text = ""
  txtMapeoDocbook.Text = ""
  txtMapeoJats.Text = ""
  txaNotas.Text = ""
  txaPendiente.Text = ""
  txtPrevia.RichText = ""

  $bCargando = False

  ' --- 2. BLANQUEO DEL ESTADO ---
  ' lblAviso NO SE TOCA: PUEDE TRAER EL MENSAJE DE RefrescarLista
  $bModificado = False
  m_Catalogo.NombreEnCurso = ""

End

' ============================================
' Función   : ActualizarBotones
' Propósito : Habilita Guardar solo con un shortcode abierto
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub ActualizarBotones()

  btnGuardar.Enabled = (m_Catalogo.NombreEnCurso <> "")

End

' ============================================
' Función   : hspPrincipal_Resize
' Propósito : Repone la proporción de los paneles: HSplit no tiene una
'             propiedad que bloquee el arrastre (como en gbCorpus).
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub hspPrincipal_Resize()

  hspPrincipal.Layout = [1, 2]

End
