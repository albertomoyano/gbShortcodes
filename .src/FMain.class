' Gambas class file

' ============================================
' Formulario: FMain
' Propósito : Vista maestro-detalle del catálogo de shortcodes. Es el
'             modelo de gbCorpus: la aplicación consulta, pule el texto
'             de la ayuda y exporta, pero NO da de alta ni elimina
'             shortcodes, ni cambia lo que decide su comportamiento
'             (nombre, tipo, grupo, estados, modo, apertura, cierre).
'             Eso se acuerda y se aplica por script SQL, después de
'             probarlo.
'             Los handlers son delgados: la lógica vive en m_Base,
'             m_Catalogo y m_Exportar.
' ============================================

' --- BANDERA DE CARGA: SUPRIME LOS EVENTOS QUE DISPARA LA PROPIA UI ---
' ASIGNAR .Index O .Text POR CÓDIGO LEVANTA Click Y Change; SIN ESTA
' BANDERA, CARGAR UN SHORTCODE LO MARCARÍA COMO MODIFICADO
Private $bCargando As Boolean

' --- ESTADO DE LA VISTA ---
Private $bModificado As Boolean

' --- ÍNDICE DEL FILTRO EFECTIVAMENTE APLICADO ---
' SE RECUERDA PARA PODER RESTAURARLO CUANDO EL USUARIO CANCELA UN
' DESCARTE DE CAMBIOS
Private $iFiltroEnCurso As Integer

' --- PESTAÑA DE LA VISTA PREVIA ---
Private Const PESTANA_PREVIA As Integer = 3

' --- IMPORTACIÓN EN CURSO ---
' MIENTRAS EL IMPORTADOR CORRE, LA SENTENCIA Wait DEJA VIVOS LOS EVENTOS
' DE LA INTERFAZ (GV-17) Y LA BASE ESTÁ CERRADA. LA BANDERA BLOQUEA EL
' RELANZAMIENTO; EL APAGADO DE LOS CONTENEDORES BLOQUEA TODO LO DEMÁS
Private $bImportando As Boolean
Private $hImportacion As Process

' --- PLAZO MÁXIMO DE LA IMPORTACIÓN ---
' NO PUEDE SER CORTO: LA ESPERA INCLUYE AL USUARIO LEYENDO LA CABECERA
' DEL SCRIPT Y CONTESTANDO EL PROMPT [s/N] EN EL TERMINAL (GV-42)
Private Const SEGUNDOS_MAXIMOS As Float = 900.0

' --- UBICACIÓN DEL IMPORTADOR DENTRO DEL PROYECTO ---
Private Const RUTA_IMPORTADOR As String = "engine/importar_shortcodes.sh"

' CARPETA DE RECURSOS DEL SISTEMA. engine/ ES INFRAESTRUCTURA Y NO SE
' PERSONALIZA: VIAJA EN EL .deb Y NO SE COPIA A ~/.gbshortcodes (SC-11)
Private Const CARPETA_SISTEMA As String = "/usr/share/gbshortcodes"

' ============================================
' Función   : Form_Open
' Propósito : Arranque en orden fail-fast: infraestructura, configuración,
'             interfaz.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Form_Open()

  ' --- 1. INFRAESTRUCTURA: SIN BASE NO HAY APLICACIÓN ---
  If Not m_Base.Conectar() Then
    ' m_Base YA INFORMÓ LA CAUSA CONCRETA
    Quit
  Endif

  ' --- 2. GEOMETRÍA GUARDADA Y TÍTULO ---
  Settings.Read(Me)
  Me.Text = "Catálogo de shortcodes — " & m_Base.RutaArchivoBase()

  ' --- 3. PROPORCIÓN DE LOS DOS PANELES ---
  hspPrincipal.Layout = [1, 2]

  ' --- 4. FILTROS Y LISTA ---
  CargarComboFiltros()
  RefrescarLista(m_Catalogo.FILTRO_TODOS)

  ' --- 5. ASPECTO DEL TERMINAL: EXPLÍCITO, NO HEREDADO (GV-42) ---
  trmImportar.Font.Name = "IBM Plex Mono"
  trmImportar.Font.Size = 12
  trmImportar.Background = Color.RGB(45, 30, 20)
  trmImportar.Foreground = Color.RGB(230, 220, 210)

  ' --- 6. ESTADO INICIAL ---
  LimpiarDetalle()
  ActualizarBotones()

End

' ============================================
' Función   : Form_Close
' Propósito : Guard de cambios sin guardar antes de cerrar (SC-06) y
'             liberación explícita de la conexión.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Form_Close()

  ' --- 1. IMPORTACIÓN EN CURSO: SE OFRECE INTERRUMPIRLA (GV-42) ---
  ' MATAR EL PROCESO ES SEGURO: sqlite3 MUERE CON LA TRANSACCIÓN ABIERTA
  ' Y SQLITE LA DESHACE. EL BUCLE DE ESPERA SALE POR EL CAMINO NORMAL
  If $bImportando Then
    If Message.Question("Hay una importación en curso." & Chr(10) & Chr(10) &
        "Interrumpirla deshace la transacción: el catálogo queda como estaba.",
        "Interrumpir", "Seguir esperando") = 1 Then
      Try $hImportacion.Kill()
    Endif
    Stop Event
    Return
  Endif

  ' --- 2. GUARD: LA SALIDA ES UN CAMBIO DE CONTEXTO MÁS ---
  If Not ConfirmarDescartarCambios() Then
    Stop Event
    Return
  Endif

  ' --- 3. EL TerminalView NO MUERE CON EL FORMULARIO ---
  Try trmImportar.Kill()

  ' --- 4. LIBERACIÓN EXPLÍCITA: NO SE DELEGA EN Finally (RC-GM-20) ---
  Settings.Write(Me)
  m_Base.Cerrar()

End

' ============================================
' Función   : cmbFiltro_Click
' Propósito : Cambia el filtro de la lista
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub cmbFiltro_Click()

  ' --- 1. EVENTO DISPARADO POR CÓDIGO: NO ES ACCIÓN DEL USUARIO ---
  If $bCargando Then Return

  ' --- 2. GUARD DE CAMBIOS SIN GUARDAR ---
  If Not ConfirmarDescartarCambios() Then
    RestaurarSeleccionFiltro()
    Return
  Endif

  ' --- 3. RECARGA DE LA LISTA CON EL NUEVO FILTRO ---
  RefrescarLista(m_Catalogo.FiltroDeIndice(cmbFiltro.Index))
  $iFiltroEnCurso = cmbFiltro.Index

  LimpiarDetalle()
  ActualizarBotones()

End

' ============================================
' Función   : lstShortcodes_Click
' Propósito : Muestra el shortcode seleccionado en el panel de detalle
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub lstShortcodes_Click()

  Dim sNombre As String

  ' --- 1. EVENTO DISPARADO POR CÓDIGO ---
  If $bCargando Then Return

  ' --- 2. GUARD DE CAMBIOS SIN GUARDAR ---
  If Not ConfirmarDescartarCambios() Then
    RestaurarSeleccionShortcode()
    Return
  Endif

  ' --- 3. CARGA DEL DETALLE ---
  sNombre = m_Catalogo.NombreDeIndice(lstShortcodes.Index)
  If sNombre = "" Then Return

  MostrarShortcode(sNombre)

End

' ============================================
' Función   : tabDetalle_Click
' Propósito : Al pasar a la vista previa, la arma con lo que está
'             escrito en la pantalla, guardado o no.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub tabDetalle_Click()

  ' --- 1. SOLO LA PESTAÑA DE LA VISTA PREVIA SE ARMA AL ENTRAR ---
  If tabDetalle.Index <> PESTANA_PREVIA Then Return

  RefrescarVistaPrevia()

End

' ============================================
' Función   : btnGuardar_Click
' Propósito : Valida y persiste los textos del shortcode en curso. Es la
'             única escritura que la aplicación hace sobre la base.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnGuardar_Click()

  Dim oFila As CShortcode
  Dim sNombre As String

  ' --- 1. VALIDACIÓN: DEBE HABER SHORTCODE EN CURSO ---
  sNombre = m_Catalogo.NombreEnCurso
  If sNombre = "" Then
    Message.Info("No hay ningún shortcode seleccionado.")
    Return
  Endif

  ' --- 2. VOLCADO DE LA UI AL OBJETO ---
  oFila = ObjetoDeUI()
  If IsNull(oFila) Then Return

  ' --- 3. GUARDAS CON MENSAJE PROPIO: EL DEL DRIVER NO DICE NADA (GV-29) ---
  If oFila.sEtiqueta = "" Then
    Message.Warning("La etiqueta no puede quedar vacía: es lo que se ve en gbpublisher.")
    txtEtiqueta.SetFocus()
    Return
  Endif

  ' LO LIBERADO SE MUESTRA EN LA AYUDA DE gbpublisher: SIN HUECOS
  ' (LO MISMO EXIGE UN CHECK DE LA TABLA)
  If oFila.EstaLiberado() Then
    If SeccionesVacias(oFila) <> "" Then
      Message.Warning(sNombre & " está liberado y no puede quedar con secciones vacías:" & Chr(10) &
        SeccionesVacias(oFila))
      Return
    Endif
  Endif

  ' --- 4. PERSISTENCIA ---
  If Not m_Catalogo.GuardarShortcode(oFila) Then Return

  $bModificado = False

  ' --- 5. LA ETIQUETA PUDO CAMBIAR: SE REARMA LA LISTA ---
  RefrescarLista(m_Catalogo.FiltroDeIndice(cmbFiltro.Index))
  SeleccionarNombre(sNombre)
  lblAviso.Text = "guardado"

  ActualizarBotones()

End

